# --- server/.env ---
# Get a free API key: https://www.datatourisme.fr/utiliser-les-donnees
DATATOURISME_API_KEY=
# 1 = synthetic Paris POIs (no key required); 0 = live DATAtourisme
MOCK_MODE=1
PORT=8787

# --- mobile (optional) ---
# On a physical device, use your machine LAN IP instead of localhost
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
